# .gitignore for React Native Expo Project

# Node.js / JavaScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Expo / React Native
.expo/
expo-env.d.ts
web-build/
dist/
.expo-shared/

# iOS
ios/
*.xcworkspace
*.xcodeproj
*.xcuserstate
*.xcuserdatad/
Pods/
Podfile.lock
*.ipa
*.dSYM.zip
*.dSYM

# Android
android/
*.iml
*.class
*.apk
*.ap_
*.aab
*.dex
*.jar
gradle/
build/
.gradle/
local.properties
*.keystore
*.jks

# TypeScript
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.production
.env.development
.env.test

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.suo
*.user
*.userosscache
*.sln.docstates

# Debugging
debug.log
debug/
.expo-instant/
.expo-debug.log

# Testing
coverage/
.nyc_output/
*.lcov

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.bak

# Metro bundler
metro-error.log
.haste-map-*
.haste-mappings-*

# Assets (optional - uncomment if you want to keep assets out of git)
# assets/*.png
# assets/*.jpg
# assets/*.jpeg
# assets/*.gif
# assets/*.svg

# Configuration files with sensitive data
app.json (if it contains sensitive keys)
google-services.json
GoogleService-Info.plist
firebase.json
firebase-debug.log

# Local development files
*.local
*.development
*.production

# Backup files
*.backup
*.old
*.orig

# Compression files
*.zip
*.tar.gz
*.rar
*.7z
